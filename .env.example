# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://lessonlab:lessonlab@localhost:5432/lessonlab?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-random-characters
TEACHER_PASSWORD=change-me
# Prefer a hash in production. Generate with: npm run hash-password -- "your-password"
# TEACHER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# AI
OPENAI_API_KEY=sk-...
AI_PROVIDER=openai
TTS_PROVIDER=openai
# Image generation for the lesson video character: openai, mock, or disabled.
# Defaults to AI_PROVIDER when unset. mock uses deterministic local artwork.
# IMAGE_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_EL=alloy
OPENAI_TTS_VOICE_EN=alloy
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Content and limits
DEFAULT_LOCALE=el
STORAGE_ROOT=./data
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=80
MAX_VIDEO_SECONDS=900
VIDEO_RENDER_TIMEOUT_MS=600000
GENERATION_MAX_ATTEMPTS=3
DEFAULT_PASS_THRESHOLD=60
CARD_MIN=8
CARD_MAX=16
QUESTIONNAIRE_MIN=10
QUESTIONNAIRE_MAX=20
GAME_MIN=10
GAME_MAX=15

# Login throttling
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=900

# Single-container image (Dockerfile target: all-in-one)
# Compose also uses POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB for its
# postgres service; the all-in-one image uses them to initialize its embedded
# database. POSTGRES_PORT and REDIS_PORT apply only to the all-in-one image.
# The all-in-one image defaults DATABASE_URL and REDIS_URL to 127.0.0.1 and
# STORAGE_ROOT to /data/media. Set the values below only to override those
# defaults or to point at external services. Do not reuse STORAGE_ROOT=./data
# from above with the all-in-one image; its media must live on /data.
# POSTGRES_USER=lessonlab
# POSTGRES_PASSWORD=lessonlab
# POSTGRES_DB=lessonlab
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# DATABASE_URL=postgresql://lessonlab:lessonlab@127.0.0.1:5432/lessonlab?schema=public
# REDIS_URL=redis://127.0.0.1:6379
# STORAGE_ROOT=/data/media
