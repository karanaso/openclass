# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://lessonlab:lessonlab@localhost:5432/lessonlab?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-random-characters
TEACHER_PASSWORD=change-me
# Prefer a hash in production. Generate with: npm run hash-password -- "your-password"
# TEACHER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# AI
OPENAI_API_KEY=sk-...
AI_PROVIDER=openai
TTS_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_EL=alloy
OPENAI_TTS_VOICE_EN=alloy

# Content and limits
DEFAULT_LOCALE=el
STORAGE_ROOT=./data
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=80
MAX_VIDEO_SECONDS=900
VIDEO_RENDER_TIMEOUT_MS=600000
GENERATION_MAX_ATTEMPTS=3
DEFAULT_PASS_THRESHOLD=60
CARD_MIN=8
CARD_MAX=16
QUESTIONNAIRE_MIN=10
QUESTIONNAIRE_MAX=20
GAME_MIN=10
GAME_MAX=15

# Login throttling
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=900
